; Managed by Basaltwater
[Globals]
; xrdp.ini file version number
ini_version=1

; Enable bitmap caching and compression for performance
bitmap_cache=true
bitmap_compression=true
bulk_compression=true

; Let the operating system size TCP buffers, as in the upstream defaults.
tcp_nodelay=true
tcp_keepalive=true

; Security settings
; security_layer=tls forces TLS-encrypted RDP and disables the legacy
; standard-RDP/RC4 fallback that 'negotiate' permits. Modern clients
; (Remmina/FreeRDP, Windows mstsc) all support TLS; only very old or
; misconfigured clients require the negotiate downgrade path.
security_layer=tls
crypt_level=high
ssl_protocols=TLSv1.2, TLSv1.3
tls_ciphers=HIGH:!aNULL:!eNULL:!EXPORT:!DES:!MD5:!PSK:!RC4
certificate=/etc/xrdp/cert.pem
key_file=/etc/xrdp/key.pem

; Color depth and display settings
max_bpp=32

; Graphics pipeline is negotiated with the client. XRDP 0.10 does not
; recognize enable_gfx; max_bpp=32 permits GFX-capable clients to use it.
blue=009cb5
grey=dedede
ls_top_window_bg_color=009cb5
ls_width=350
ls_height=430
ls_bg_color=dedede
ls_logo_filename=
ls_title=xRDP
ls_logo_x_pos=55
ls_logo_y_pos=50

; Session management
autorun=
use_fastpath=both
new_cursors=true
; Allow session reconnection and the explicitly listed channels below
allow_channels=true
allow_multimon=true
; Idle/disconnected session limits are configured in sesman.ini.

; Fork a separate process per session for stability
fork=true

; Listener managed by --rdp-bind-address
port={RDP_LISTENER}
runtime_user=xrdp
runtime_group=xrdp

[Logging]
LogFile=xrdp.log
LogLevel=INFO
EnableSyslog=true
SyslogLevel=INFO

[Channels]
; Dynamic virtual channels remain enabled for resize support. The coding-host
; baseline permits clipboard transfer, but blocks drive/device, printer,
; audio, RemoteApp, and video redirection unless explicitly requested.
rdpdr={RDP_DRIVE_REDIRECTION}
rdpsnd={RDP_AUDIO}
drdynvc=true
cliprdr={RDP_CLIPBOARD}
rail=false
xrdpvr=false

; Session types
[Xorg]
name=Xorg
lib=libxup.so
username=ask
password=ask
port=-1
code=20
